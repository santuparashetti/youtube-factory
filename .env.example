# YouTube Factory — Environment Configuration
# Copy this file to .env and fill in your API keys.
#
# Required: at least one LLM provider key + TAVILY_API_KEY

# ------------------------------------------------------------------
# API Keys
# ------------------------------------------------------------------
# HF_TOKEN=hf_vBVwLYMi...inQRIovGmR
# GEMINI_API_KEY=AQ.Ab8RN6L7qx1_....EjEUytoVNEiQ
# TAVILY_API_KEY=tvly-dev-228ChL-MJM3I7An....xhaOTBF0XcO
# GROQ_API_KEY=gsk_TsYX7yIWnbjcRB2A8ha....QMbncwAY584
# ANTHROPIC_API_KEY=sk-or-v1-6f9100894b....3d89b93866281
# CARTESIA_API_KEY=sk_car_EwuVvUg9...KnbCgW
# ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Reference working config (from the maintainer's live .env): anthropic routed
# through an OpenRouter proxy, model=deepseek/deepseek-v3.2. Swap ANTHROPIC_BASE_URL
# back to https://api.anthropic.com if you have a real Anthropic key instead.
LLM_PROVIDER=anthropic       # gemini | anthropic | groq | ollama | huggingface

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1   # or https://api.anthropic.com
ANTHROPIC_MODEL=deepseek/deepseek-v3.2             # or claude-haiku-4-5 on the official API
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_TEXT_MODEL=gemini-2.5-flash

# ── Script Selector + Polisher ───────────────────────────────────────────────
# Composer emits two variants (A/B); the polisher picks the stronger one and
# makes only the minimum necessary changes (≤10%). Runs on the same provider via
# a model override, so this id must be valid for your provider/proxy (OpenRouter
# in the reference config). SCRIPT_POLISHER_MAX_TOKENS is reserved — not wired to
# the provider call (generate() has no per-call max_tokens param).
SCRIPT_POLISHER_MODEL=anthropic/claude-opus-4-5   # top model for final script polish
SCRIPT_POLISHER_TEMPERATURE=0.3                    # low temp — precision, not creativity
SCRIPT_POLISHER_MAX_TOKENS=4000                    # reserved (not wired) — full script + report JSON
COMPOSER_VARIANT_TEMP_A=0.62                       # composer variant A temperature
COMPOSER_VARIANT_TEMP_B=0.58                       # composer variant B temperature

# ------------------------------------------------------------------
# Hugging Face LLM (optional alternative — commented out so it doesn't
# silently override LLM_PROVIDER above; matches live .env)
# ------------------------------------------------------------------

# LLM_PROVIDER=huggingface
# HF_LLM_PROVIDER=deepinfra
# HF_LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# HF_LLM_TIMEOUT=60
# HF_LLM_MAX_RETRIES=3

# ── Search ────────────────────────────────────────────────────────────────────
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# ── Image Generation ──────────────────────────────────────────────────────────
IMAGE_PROVIDER=huggingface   # huggingface | gemini | pollinations
HF_TOKEN=                    # Required for some HuggingFace models

# Tier 1 — default / first-pass (cheap, fast)
IMAGE_MODEL_TIER1_ID=black-forest-labs/FLUX.1-schnell
IMAGE_MODEL_TIER1_PROVIDER=auto        # auto | hf-inference | fireworks-ai | featherless-ai | together

# Tier 2 — first escalation (quality)
IMAGE_MODEL_TIER2_ID=Qwen/Qwen-Image
IMAGE_MODEL_TIER2_PROVIDER=auto

# Tier 3 — final escalation (premium, last resort)
IMAGE_MODEL_TIER3_ID=black-forest-labs/FLUX.1-dev
IMAGE_MODEL_TIER3_PROVIDER=auto

GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# ── Text-to-Speech ────────────────────────────────────────────────────────────
# Provider-agnostic voice profile — all narration references this instead of
# provider-specific knobs. New styles only require a registry entry.
VOICE_PROFILE=atma_theory

TTS_PROVIDER=cartesia          # edge | kokoro | cartesia | elevenlabs | fish
# Kokoro (local neural TTS — no API key, downloads ~300 MB on first run):
#   uv pip install kokoro soundfile && apt install espeak-ng
KOKORO_VOICE=am_michael
KOKORO_SPEED=0.85

# Cartesia (premium cloud TTS — documentary / spiritual narration; active provider)
# Install: uv pip install cartesia
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3.5
CARTESIA_VOICE_ID=65209f8e-6140-4a20-b819-3cc2e21da19b  # Nolan
CARTESIA_SPEED=0.88
CARTESIA_OUTPUT_FORMAT=wav
CARTESIA_TIMEOUT=90
CARTESIA_MAX_CHARS=2500
CARTESIA_CACHE_ENABLED=true
CARTESIA_PRONUNCIATION_DICT_ID=
CARTESIA_SAMPLE_RATE=48000
CARTESIA_EMOTION=contemplative

# ElevenLabs (cloud TTS — fast, high-quality voices)
# Install: uv pip install elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=ZthjuvLPty3kTMaNKVKb  # Peter
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT=60
ELEVENLABS_MAX_CHARS=2500
ELEVENLABS_CACHE_ENABLED=true
ELEVENLABS_SAMPLE_RATE=44100

# Fish Audio (cloud TTS — fast, high-quality voices)
# Install: uv pip install requests
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free
FISH_REFERENCE_ID=
FISH_FORMAT=mp3
FISH_SPEED=1.0
FISH_SAMPLE_RATE=44100
FISH_TEMPERATURE=0.7
FISH_TOP_P=0.7
FISH_REPETITION_PENALTY=1.2
FISH_MAX_NEW_TOKENS=1024
FISH_NORMALIZE=true
FISH_TIMEOUT=60
FISH_MAX_RETRIES=3
FISH_CACHE_ENABLED=true

# ── TTS Analytics & Cost Tracking ────────────────────────────────────────────
TTS_ANALYTICS_ENABLED=true
TTS_COST_TRACKING=true
TTS_LOG_PER_SCENE=true
TTS_SUMMARY_ENABLED=true
TTS_VERIFY_CACHE=true

# Pricing as of July 2026 (Cartesia Pro)
# TTS: 1 credit per character
# Pro: 100,000 credits for $5/month
CARTESIA_CREDITS_PER_CHARACTER=0
CARTESIA_CREDITS_PER_REQUEST=0
CARTESIA_USD_PER_CREDIT=0

# ── Pipeline Quality Gates ────────────────────────────────────────────────────
STOP_ON_QUALITY_GATE_FAILURE=true

# ── WhisperX Forced Alignment ─────────────────────────────────────────────────
WHISPERX_ENABLED=false       # true to enable word-level subtitle alignment
WHISPERX_MODEL=base          # base | small | medium — reserved for future transcription use
WHISPERX_DEVICE=cpu          # cpu | cuda

# ── Video Settings ────────────────────────────────────────────────────────────
IMAGE_WIDTH=1280
IMAGE_HEIGHT=720
RENDER_PROFILE=cinematic     # draft | balanced | cinematic | premium | pan_only

# ── Background Music ──────────────────────────────────────────────────────────
BGM_ENABLED=false
BGM_CATEGORY=auto           # auto | spiritual | meditation | cinematic_ambient | ...
BGM_LIBRARY_PATH=workspace/music
BGM_VOLUME=0.20             # BGM level during silence (0.0–1.0)
BGM_DUCK_FLOOR=0.07         # minimum BGM level during narration
BGM_DUCK_THRESHOLD=0.025    # amplitude threshold for ducking onset
BGM_DUCK_RATIO=3.0          # sidechain compressor ratio
BGM_DUCK_ATTACK_MS=15       # V2 legacy attack — overridden by V3 adaptive (180 ms)
BGM_DUCK_RELEASE_MS=350     # V2 legacy release — overridden by V3 adaptive (1800 ms)
BGM_FADE_IN_SECONDS=2.5
BGM_FADE_OUT_SECONDS=3.5
BGM_RANDOM_TRACK=true
BGM_VAD_ENABLED=true
BGM_PHRASE_GAP_MS=300       # V2 agate hold (ms); replaced by BGM_HOLD_AFTER_SPEECH_MS in V3

# ── BGM V3: Adaptive State-Machine Mixing ────────────────────────────────────
# Cinematic ducking: music stays down through breaths/commas/dramatic pauses.
# Only genuine long silence (>2.5 s) raises music. No pumping.
BGM_ADAPTIVE_MIXING=true
BGM_HOLD_AFTER_SPEECH_MS=2200      # hold music ducked this long after speech ends
BGM_LONG_SILENCE_THRESHOLD_MS=2500 # silence longer than this = MUSIC_FEATURE state
BGM_LONG_SILENCE_MS=2500           # review rule threshold (kept for backward compat)
BGM_NARRATION_LEVEL_LUFS=-18.0      # target narration LUFS (for review/debug) — matches live .env's BGM_NARRATION_LEVEL_LUFS override
BGM_MUSIC_LEVEL_LUFS=-17.0         # target music LUFS during silence
BGM_TRANSITION_CURVE=ease_in_out

# ── Image Review (Vision Quality Gate) ───────────────────────────────────────
# Disabled by default (lightweight mode, no model/API calls required).
# Reference working config uses the huggingface provider (Qwen2.5-VL-32B via
# HF Inference), not a locally-downloaded model.
IMAGE_REVIEW_ENABLED=false
VISION_REVIEW_PROVIDER=huggingface      # local | mock | gemini | huggingface
HF_VISION_MODEL=Qwen/Qwen2.5-VL-32B-Instruct   # used when VISION_REVIEW_PROVIDER=huggingface
HF_VISION_PROVIDER=auto                 # auto | hf-inference | fireworks-ai | featherless-ai | together | novita | cerebras
VISION_MAX_CONCURRENCY=1                # max concurrent vision QA requests (1-100); reference config throttles to 1 to avoid 429s
# VISION_REVIEW_LOCAL_MODEL=qwen2_5_vl_3b  # when VISION_REVIEW_PROVIDER=local (llama.cpp, active default local model)
# VISION_REVIEW_LOCAL_MODEL=minicpm_v2_6   # alternative local model (A/B option, ~10 GB, transformers backend)
IMAGE_REVIEW_MIN_SCORE=90
IMAGE_REVIEW_CONFIDENCE=80
IMAGE_REVIEW_MAX_ATTEMPTS=3
IMAGE_REVIEW_AUTO_REMEDIATE=true
IMAGE_REVIEW_DEBUG=false

# ── Image Review — Anatomy hard-floor defense-in-depth (0–100 scale) ───────────
IMAGE_REVIEW_ANATOMY_FLOOR_THRESHOLD=6.0
IMAGE_REVIEW_ANATOMY_QUALITY_CAP=6.0

# ── Image Generation — Escalation Policy (0–10 scale) ─────────────────────────
IMAGE_ESCALATION_TARGET_QUALITY_SCORE=9.2
IMAGE_ESCALATION_RETRY_THRESHOLD=8.5
IMAGE_ESCALATION_PREMIUM_MODEL_THRESHOLD=8.5
IMAGE_ESCALATION_MAX_PROMPT_REFINEMENTS=1
IMAGE_ESCALATION_MAX_MODEL_ESCALATIONS=2

# ── Scene Planner — Retry & Faithfulness Validation ──────────────────────────
SCENE_PLANNER_MAX_RETRIES=2
SCENE_PLANNER_JSON_MODE=true
SCENE_PLANNER_STRICT_SCHEMA=false
FAITHFULNESS_GATE_FAIL_PIPELINE=false
FAITHFULNESS_LLM_VALIDATION_ENABLED=true
FAITHFULNESS_VALIDATOR_MODEL=google/gemini-2.5-flash-lite
FAITHFULNESS_VALIDATOR_FALLBACK_MODEL=deepseek/deepseek-v4-flash
FAITHFULNESS_VALIDATOR_MAX_TOKENS=150
VISUAL_ANCHOR_ENABLED=true
TTS_SKIP_EXISTING=true
# Set false to skip burning subtitles into video — upload .srt to YouTube instead
SUBTITLE_BURN_ENABLED=true
OVERLAY_ENABLED=true
OVERLAY_GRAIN_ENABLED=true
OVERLAY_SMOKE_ENABLED=true
OVERLAY_PARTICLES_ENABLED=true
OVERLAY_GOD_RAYS_ENABLED=true
OVERLAY_RAIN_ENABLED=true
OVERLAY_FOG_ENABLED=true
IMAGE_QA_ENABLED=true
IMAGE_QA_MAX_TOKENS=200

# ── Post-processing: Video Split ─────────────────────────────────────────────
# Split final.mp4 into 2-3 parts at scene boundaries; output goes to Epidemic
# Sound for BGM/sound layering.
# VIDEO_SPLIT_ENABLED=false
VIDEO_SPLIT_ENABLED=false
# VIDEO_SPLIT_LENGTH=4.0
VIDEO_SPLIT_LENGTH=4.0

# ── Runtime ───────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT=60

VIDEO_DEBUG_SHOWINFO=false
OVERLAY_GRAIN_ENABLED=false

# ── Anchor character system (Kai) ───────────────────────────────────────────────────────────────────
# Anchor character system (Kai). Default: enabled.
# Set to false to disable for shorts_factory or debug runs.
# ANCHOR_CHARACTER_ENABLED=true
# ANCHOR_CHARACTER_ID=Kai

# Script Judge + Guided Recomposer
# Override to use a better model for high-stakes script quality decisions.
# Any OpenRouter model string is valid (e.g. anthropic/claude-opus-4,
# openai/gpt-4o, google/gemini-2.5-pro). Defaults to the main LLM_MODEL.
SCRIPT_JUDGE_ENABLED=true
SCRIPT_JUDGE_MODEL=deepseek/deepseek-v3.2
GUIDED_RECOMPOSE_ENABLED=true
GUIDED_RECOMPOSER_MODEL=deepseek/deepseek-v3.2

# Visual Anchor generation models (primary + fallback)
VISUAL_ANCHOR_MODEL=google/gemini-2.5-flash-lite
VISUAL_ANCHOR_FALLBACK_MODEL=deepseek/deepseek-v4-pro

# Characters will be illustrated storybook style, not photorealistic
HYBRID_STYLE_ENABLED=false

AUDIENCE_PROFILE=western_english